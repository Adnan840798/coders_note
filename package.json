{
  "name": "coders-note",
  "version": "0.1.0",
  "description": "A competitive programming assistant — contest tracker, profile analysis, resource hub.",
  "main": "out/main/index.js",
  "author": "coders_note contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev -c electron.vite.config.ts",
    "build": "electron-vite build -c electron.vite.config.ts",
    "preview": "electron-vite preview -c electron.vite.config.ts",
    "package": "electron-vite build -c electron.vite.config.ts && electron-builder",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "lint": "eslint . --ext .ts,.svelte",
    "format": "prettier --write .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "electron-updater": "^6.1.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@playwright/test": "^1.43.1",
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/better-sqlite3": "^7.6.9",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-svelte": "^2.39.0",
    "prettier": "^3.2.5",
    "prettier-plugin-svelte": "^3.2.3",
    "svelte": "^4.2.15",
    "svelte-check": "^3.7.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "vitest": "^1.5.2"
  }
}
